  "internal_policy": [
    "Crumblecrusher executes minion, location, then equipped-weapon destruction through existing checkpoints; each later type is queried at its actual stage. Exact CN simultaneous/sequential policy remains uncalibrated.",
    "The single currently equipped enemy weapon is destroyed as an ordinary weapon, without an artificial second weapon slot or random pool.",
    "Petal Peddler uses current complete Dragon membership excluding its own physical entity; Dragon Turtle checks actual held Dark Gifts after leaving hand.",
    "Conflux Crasher uses ordinary minion ability random damage and one existing Rewind retry; candidate membership is refreshed for every actual battlecry."
  ],
  "formal_pool_complete": false,
  "cn_calibrated": false
}
