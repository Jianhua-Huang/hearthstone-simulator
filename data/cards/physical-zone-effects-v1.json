  "reviewed_policy": {
    "discard": "Two sequential actual random discards with reactions, not two preselected cards.",
    "steamcleaner": "One captured set across both decks; original physical cards from either starting deck protected unless explicitly replacement-transformed.",
    "transform": "Explicit board/stored replacement transforms lose initial-deck credit, including same-face and later transform-back. Intrinsic forms preserve existing credit.",
    "destruction": "Commit all currently valid captured deck removals before notifications and native bodies; no discard/death/fatigue.",
    "muster": "Three attributed CS2_101t summons then equip complete CS2_091; IDs follow official childIds, not text placeholders.",
    "limit": "Internal source/lifecycle policy; exact CN transform-origin, batch order and intrinsic-form exceptions require calibration."
  }
